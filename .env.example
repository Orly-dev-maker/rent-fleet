# Copiez ce fichier en .env (local) ou collez ces valeurs dans les variables d'environnement
# de votre hébergeur. Ne publiez jamais les vraies valeurs.

# ---------------------------------------------------------------------------
# Base de données (obligatoire)
# Chaîne de connexion PostgreSQL. Les bases hébergées demandent ?sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Connexions simultanées par instance du site (optionnel, 5 par défaut).
# DB_POOL_MAX="5"

# ---------------------------------------------------------------------------
# Authentification (obligatoire)
# NEXTAUTH_URL : adresse publique du site, sans "/" final.
# NEXTAUTH_SECRET : chaîne aléatoire, générée avec : openssl rand -base64 32
# ADMIN_EMAILS : adresses (séparées par des virgules) qui reçoivent le rôle admin à la connexion.
# ---------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"   # 32 caractères minimum
ADMIN_EMAILS="admin@yourdomain.com"

# Adresse publique utilisée pour robots.txt, sitemap.xml et les liens absolus. Facultatif :
# à défaut, NEXTAUTH_URL est utilisée.
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # en production : https://votre-domaine.com (sert aussi au contact par défaut : contact@votre-domaine.com)

# E-mails (lien de connexion, confirmations de réservation) : serveur SMTP de votre fournisseur.
# Laissez SMTP_HOST vide en développement : le lien de connexion s'affiche alors dans la console
# du serveur, et le site ne plante pas (les e-mails de réservation ne sont simplement pas envoyés).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Expéditeur des e-mails : une adresse de contact sur votre domaine (pas d'adresse gratuite de type webmail).
# Si vous laissez vide, le site utilise l'adresse de contact saisie dans /admin/settings.
EMAIL_FROM="Votre Marque <contact@votre-domaine.com>"
# Alternative à SMTP_* : une seule URL, ex. smtp://user:motdepasse@smtp.votrefournisseur.com:587
# EMAIL_SERVER=""

# Connexion Google (optionnelle, laissez vide pour masquer le bouton)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Paiement en ligne (Stripe)
# Les clés de test commencent par sk_test_ / pk_test_. Le secret du webhook (whsec_...) est
# affiché à la création du point de terminaison <votre site>/api/webhooks/stripe.
# Sans clés, le site fonctionne et indique que la réservation n'est pas encore disponible.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Devise des prix et des paiements (code ISO en minuscules) : eur, usd, gbp, chf...
# Devises à 2 décimales uniquement (pas de jpy ni krw).
STRIPE_CURRENCY="eur"

# ---------------------------------------------------------------------------
# Envoi des photos de véhicules (Cloudinary, l'offre gratuite suffit)
# Tableau de bord Cloudinary > Settings > API Keys. Sans ces valeurs, les photos
# peuvent quand même être ajoutées par adresse d'image.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Nettoyage planifié des réservations non payées
# Chaîne aléatoire. Elle est acceptée en en-tête "x-cron-secret: <valeur>" ou en
# "Authorization: Bearer <valeur>" (ce que Vercel Cron envoie) sur /api/cron/expire-pending.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Démo en ligne uniquement : mettre "true" pour afficher une courte mention sur les images
# d'illustration. "false" pour une installation réelle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE="false"
